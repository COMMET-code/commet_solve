{
    "mesh": {
        /* required: true
        options:
            "builtin" -- uses a mesh that the solver generates
            "read" -- reads a mesh from file
        */
        "from": "read",
        /* required: true (if using builtin)
        options:
            "cube" -- generates
            "cylinder" -- reads a mesh from file
        */
        "path": "./hole.msh",
        "order": 1,
        "global_refines": 0
    },
    "materials": [
        {
            "id": 0,
            "type": "neohookean",
            "lambda": 4000,
            "mu":6900
        }
        // {
        //     "id": 0,
        //     "type": "batch_vectorized_ncm",
        //     "evaluation_method": "optimized",
        //     "batch_size": 512,
        //     // "evaluation_method": "using_C",
        //     // "path_to_torchscript": "../resources/torchscripts/opt/opt-neohookean-micnn-cpu.torchscript"
        //     "path_to_torchscript": "opt-neohookean-micnn-cpu.torchscript"
        // }
    ],
    "stages": [
        {
            "end_time": 1,
            "time_increment_size": 0.1,
            "dirichlet_boundary_conditions": [
                {
                    "type": "standard",
                    "boundary_id": 1,
                    "components": [
                        0
                    ],
                    "values": [
                        0
                    ]
                },
                {
                    "type": "standard",
                    "boundary_id": 3,
                    "components": [
                        1
                    ],
                    "values": [
                        0
                    ]
                },
                {
                    "type": "standard",
                    "boundary_id": 5,
                    "components": [
                        2
                    ],
                    "values": [
                        0
                    ]
                },
                {
                    "type": "standard",
                    "boundary_id": 4,
                    "components": [
                        0,
                        1,
                        2
                    ],
                    "values": [
                        0,
                        1,
                        0
                    ]
                }
            ],
            "neumann_boundary_conditions": [
            ],
            "robin_boundary_conditions": [

            ]
        }
    ],
    "outputs": {
        "scalar_outputs": [
            "I1"
        ],
        "vector_outputs": [],
        "tensor_outputs": [
            "kirchhoff_stress",
            "C"
        ]
    },
    "sparse_solver_settings": {
         "solver_type": "direct",
        //"solver_type": "cg",
        // "preconditioner_type": "amg",
        "symmetric": true
    },
    "miscellaneous": {
        "output_vtus": true,
        "nr_threshold": 1e-7,
        "max_nr_iterations": 4
    }
}
